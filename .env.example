# ฐานข้อมูล MySQL ของระบบ POS (inventory.dyndns.tv) — แอปนี้อ่านอย่างเดียว ไม่เคยเขียน
# ใช้กับใบเบิก/สินค้า/สาขา (orderd / item / store) ซึ่งเป็นของผู้ขายระบบ POS ย้ายไปไหนไม่ได้
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# เซิร์ฟเวอร์ที่ออฟฟิศ (office-server ของโปรเจกต์ Narai-branch) — ทางเดียวที่เข้าถึง SQL Server
# ได้ เพราะไฟร์วอลล์ที่นั่นเปิดพอร์ต 1433 ให้เฉพาะ IP ในไทย
# เว้นว่างได้ จะใช้ค่าเริ่มต้น http://storenarai.dyndns.tv:8787
USAGE_API_BASE=
# ใส่ให้ตรงกับ API_TOKEN ที่ตั้งไว้ฝั่ง office-server — ถ้าฝั่งนั้นไม่ได้ตั้ง ก็เว้นว่างไว้
USAGE_API_TOKEN=

# แหล่งข้อมูลงานสโตร์ (จัดของ / รับของ / ดึงข้อมูลใบเบิก / ยกเลิกใบเบิก)
#   sheet = Google Sheet เหมือนเดิม (ค่าเริ่มต้น)
#   sql   = SQL Server ผ่าน office-server
# ห้ามตั้งเป็น sql ก่อนที่จะรันสคีมาและ deploy แพตช์ office-server เสร็จ ไม่งั้นหน้าเว็บจะพัง
# ขั้นตอนทั้งหมดอยู่ใน docs/move-to-sqlserver.md
STORE_SOURCE=sheet

# ทะเบียนสาขากลาง (แดชบอร์ดออฟฟิศ naraipizzeria) — แอปนี้ดึงรายชื่อสาขาไปใช้ อ่านอย่างเดียว
# เดิมรายชื่อสาขา hardcode อยู่ใน lib/branches.js เปิดสาขาใหม่ทีต้องแก้โค้ดแล้ว deploy
# และเคยหลุดกับอีกสองระบบมาแล้ว (HPS ที่นี่เป็น outlet 902 แต่อีกสองที่ใช้ 109)
# เว้นว่างทั้งคู่ = ไม่ดึง ใช้รายชื่อที่ฝังไว้ในโค้ดต่อไปเหมือนเดิม
BRANCH_HUB_BASE=
# ต้องตรงกับ BRANCH_FEED_KEY ที่ตั้งไว้ฝั่งแดชบอร์ดออฟฟิศ
BRANCH_FEED_KEY=

PORT=3000
