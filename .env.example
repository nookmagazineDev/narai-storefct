# ฐานข้อมูล MySQL ของระบบ POS (inventory.dyndns.tv)
# ฐานตั้งต้นคือ myfbdata ซึ่งแอปนี้อ่านอย่างเดียว (orderd / item / store)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# ฐานข้อมูลของแอปนี้เอง — ตารางจัดของ/รับของ/ดึงข้อมูล/ยกเลิก (ดู docs/schema-store.sql)
# อยู่บนเซิร์ฟเวอร์เดียวกับ MYSQL_HOST ข้างบน ใช้ connection เดียวกัน
STORE_DB=narai_store

# เปิดการเขียนลง MySQL คู่ขนานกับ Google Sheet (dual-write)
# ตั้งเป็น 1 ก็ต่อเมื่อรัน docs/schema-store.sql และ scripts/sync-store-db.mjs เรียบร้อยแล้ว
# ปิดค่านี้เมื่อไหร่ ระบบกลับไปเขียนเฉพาะชีทเหมือนเดิมทันที
STORE_DB_WRITE=0

PORT=3000
